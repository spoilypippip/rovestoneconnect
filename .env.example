# Copy to .env.local and fill in before launch. Everything here is
# optional in development - unconfigured providers log to the server
# console instead of failing the checkout/quote-request flow.
#
# EXCEPTION: on Vercel (or any serverless host), SUPABASE_URL and
# SUPABASE_SERVICE_ROLE_KEY below are NOT optional - without them, orders
# fall back to a local SQLite file that doesn't persist across requests
# there. See lib/orders/supabase.sql for the schema to run first.

# --- Order storage (lib/orders) ---
# From your Supabase project's Settings > API page. The service-role key
# is server-only - never expose it to the browser (it isn't, here).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Manual transfer payment (lib/payments/manual-transfer.ts) ---
# Used when STRIPE_SECRET_KEY below is unset.
PROMPTPAY_ID=
BANK_NAME=
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=

# --- Stripe Checkout (lib/payments/stripe.ts) ---
# Setting STRIPE_SECRET_KEY switches checkout from manual transfer to
# Stripe automatically - no other config needed to change providers.
# From your Stripe Dashboard: Developers > API keys. Use a test-mode
# ("sk_test_...") key until you're ready to accept real payments, then
# switch to the live key ("sk_live_...").
STRIPE_SECRET_KEY=
# From Developers > Webhooks, after adding an endpoint pointing at
# <your site>/api/webhooks/stripe listening for
# checkout.session.completed. Required for orders to ever be marked
# "paid" - without it, Stripe Checkout still takes payment but this site
# never finds out.
STRIPE_WEBHOOK_SECRET=
# This site's https origin, used to build Stripe's success/cancel
# redirect URLs. Not needed on Vercel, which sets VERCEL_URL itself.
SITE_URL=

# --- Customer-facing LINE handoff (app/order/[id]/confirmation) ---
# The "@..." handle of your LINE Official Account, without the "@".
LINE_OA_ID=

# --- Internal notifications (lib/notifications) ---
# "email" (default) or "line".
NOTIFICATION_PROVIDER=email

# Email provider (Resend REST API, no SDK dependency).
RESEND_API_KEY=
NOTIFICATION_EMAIL_FROM=
NOTIFICATION_EMAIL_TO=

# LINE Messaging API push (NOTIFICATION_PROVIDER=line). LINE Notify was
# discontinued March 31, 2025 - this is the Messaging API's push endpoint,
# issued from the LINE Official Account Manager.
LINE_CHANNEL_ACCESS_TOKEN=
LINE_TARGET_ID=
